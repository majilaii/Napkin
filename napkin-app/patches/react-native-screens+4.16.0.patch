+#ifdef RCT_NEW_ARCH_ENABLED
+/// Re-imposes the screen's own size on our content wrapper when React left a stale frame there.
+///
+/// Symptom this fixes: on a cold launch the first screen mounted in a native stack can end up with a
+/// `RNSScreenContentWrapper` whose native frame is shorter than the screen (e.g. 758 vs 874pt on an
+/// iPhone 17 Pro) while the wrapper's own children already got the final height. The wrapper does not
+/// clip, so the content still paints, but `-hitTest:withEvent:` returns nil below the stale height and
+/// the bottom band of the screen becomes completely untouchable.
+///
+/// Here UIKit owns the screen's size (the size is pushed to the shadow tree from `-updateBounds`), so
+/// `self.bounds` is the source of truth. `formSheet` is excluded: there the wrapper's height is
+/// deliberately content-driven because it drives the sheet detents (see
+/// `-contentWrapper:receivedReactFrame:`). The origin is preserved — with a translucent/large header the
+/// shadow tree offsets the content via `contentOffset`, not by moving the wrapper.
+- (void)syncContentWrapperSizeToScreenBoundsIfNeeded
+{
+  if (_stackPresentation == RNSScreenStackPresentationFormSheet) {
+    return;
+  }
+
+  RNSScreenContentWrapper *_Nullable contentWrapper = _contentWrapperBox.contentWrapper;
+  const CGSize screenSize = self.bounds.size;
+
+  if (contentWrapper == nil || screenSize.width <= 0 || screenSize.height <= 0 ||
+      CGSizeEqualToSize(contentWrapper.bounds.size, screenSize)) {
+    return;
+  }
+
+  CGRect correctedFrame = contentWrapper.frame;
+  correctedFrame.size = screenSize;
+  contentWrapper.frame = correctedFrame;
+}
+#endif // RCT_NEW_ARCH_ENABLED
+
